# ===================================================================
# MECC Backend Environment Variables
# Copy this file to .env and fill in your values
# ===================================================================

# -------------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:newstrongpassword@localhost/mecc_db

# -------------------------------------------------------------------
# MODEL
# -------------------------------------------------------------------
MODEL_CHECKPOINT_PATH=checkpoints/at.pth

# -------------------------------------------------------------------
# LLM (Ollama - must be running separately)
# -------------------------------------------------------------------
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# -------------------------------------------------------------------
# SPEECH-TO-TEXT (Whisper)
# -------------------------------------------------------------------
WHISPER_MODEL_SIZE=base
# Options: tiny, base, small, medium, large
# Recommendation: base (good balance of speed & accuracy)

USE_WHISPER_API=false
# Set to true to use OpenAI Whisper API (requires API key - NOT FREE)
# Leave as false to use local Whisper model (FREE)

# -------------------------------------------------------------------
# AUDIO STORAGE
# -------------------------------------------------------------------
AUDIO_STORAGE_DIR=./audio_storage

KEEP_AUDIO=false
# Set to true for development/debugging (keeps audio files)
# Set to false for production (auto-deletes after processing)

# ===================================================================
# NOTES:
# ===================================================================
# 1. No DEVICE variable needed - GPU/CPU auto-detected
# 2. Make sure Ollama is running: `ollama serve`
# 3. Create PostgreSQL database before starting backend
# ===================================================================
